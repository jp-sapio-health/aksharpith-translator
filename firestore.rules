rules_version = '2';

// Aksharpith Firestore security rules.
// Default deny. Owner-only access on user-scoped documents.
// Server-side writes via firebase-admin SDK bypass these rules.
// Admins (custom claim { admin: true } set by scripts/seed-admin.mjs) read across all uids.

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    function isAdmin() {
      return isSignedIn() && request.auth.token.admin == true;
    }

    // Translation jobs — created by API route, polled by worker (admin SDK).
    // Clients read their own jobs for progress/status; admins read all jobs.
    match /jobs/{jobId} {
      allow read: if isOwner(resource.data.uid) || isAdmin();
      allow create, update, delete: if false; // server only
    }

    // Translation results.
    match /translations/{translationId} {
      allow read: if isOwner(resource.data.uid) || isAdmin();
      allow create: if isOwner(request.resource.data.uid);
      allow update: if isOwner(resource.data.uid)
                    && request.resource.data.uid == resource.data.uid;
      allow delete: if isOwner(resource.data.uid) || isAdmin();

      // Per-translation reviewer comments.
      match /reviews/{reviewId} {
        // Anyone signed in who can read the parent translation can read reviews.
        // Admins can also read.
        allow read: if isAdmin()
                    || (isSignedIn()
                        && get(/databases/$(database)/documents/translations/$(translationId)).data.uid == request.auth.uid);
        allow create: if isOwner(request.resource.data.uid);
        allow update, delete: if isOwner(resource.data.uid);
      }
    }

    // Transliteration-first jobs (page-by-page OCR + transliteration).
    // Created by /api/upload, mutated by the local worker via admin SDK
    // (which bypasses these rules). Clients read their own jobs and
    // subscribe to the pages subcollection for live progress; admins read
    // all jobs.
    match /transliterationJobs/{jobId} {
      allow read: if isOwner(resource.data.uid) || isAdmin();
      allow create, delete: if false; // server only
      // Owners may flip translateRequested true→false; nothing else.
      allow update: if isOwner(resource.data.uid)
                    && request.resource.data.uid == resource.data.uid
                    && request.resource.data.kind == 'transliteration'
                    && request.resource.data.diff(resource.data).affectedKeys()
                       .hasOnly(['translateRequested']);

      // Per-page OCR progress — read-only to clients/admins; worker writes.
      match /pages/{pageNum} {
        allow read: if isAdmin()
                    || (isSignedIn()
                        && get(/databases/$(database)/documents/transliterationJobs/$(jobId)).data.uid == request.auth.uid);
        allow create, update, delete: if false; // server only
      }
    }

    // Future: editorial glossary overrides (Tier 2). Admins write, anyone signed in reads.
    match /config/{document=**} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // Catch-all: deny.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
