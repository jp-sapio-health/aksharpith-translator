rules_version = '2';

// Aksharpith uploads
//
// Files >4.5 MB cannot be POSTed through Vercel's serverless body limit, so the
// client uploads them directly to Firebase Storage and the API route fetches
// them server-side via the admin SDK. These rules govern the client-side leg
// only — the admin SDK bypasses rules and is rate-limited by Firestore writes.
service firebase.storage {
  match /b/{bucket}/o {
    // Each authenticated user has an isolated upload folder. They may write
    // their own files (50 MB cap) and read them back for client-side previews.
    match /uploads/{uid}/{allPaths=**} {
      allow read:  if request.auth != null && request.auth.uid == uid;
      allow write: if request.auth != null
                   && request.auth.uid == uid
                   && request.resource.size < 50 * 1024 * 1024
                   && request.resource.contentType.matches('application/pdf|application/.*word.*|image/.*|text/plain');
    }

    // Default deny everything else.
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
